{
  "name": "pi-terminal-bridge",
  "displayName": "%extension.displayName%",
  "description": "%extension.description%",
  "version": "0.0.1",
  "repository": {
    "type": "git",
    "url": "https://github.com/onetooken/pi-terminal-bridge.git"
  },
  "publisher": "local",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "onCommand:piTerminal.open",
    "onCommand:piTerminal.sendReference",
    "onCommand:piTerminal.sendSelection"
  ],
  "main": "./out/extension.js",
  "l10n": "./l10n",
  "contributes": {
    "commands": [
      {
        "command": "piTerminal.open",
        "title": "%commands.open.title%",
        "icon": {
          "light": "media/pi-light.svg",
          "dark": "media/pi-dark.svg"
        }
      },
      {
        "command": "piTerminal.sendReference",
        "title": "%commands.sendReference.title%"
      },
      {
        "command": "piTerminal.sendSelection",
        "title": "%commands.sendSelection.title%"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "piTerminal.open",
          "group": "navigation@70"
        }
      ],
      "editor/context": [
        {
          "command": "piTerminal.sendReference",
          "when": "editorTextFocus",
          "group": "navigation@80"
        },
        {
          "command": "piTerminal.sendSelection",
          "when": "editorTextFocus",
          "group": "navigation@81"
        }
      ]
    },
    "configuration": {
      "title": "%configuration.title%",
      "properties": {
        "piTerminal.command": {
          "type": "string",
          "default": "pi",
          "description": "%configuration.command.description%"
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "vscode:prepublish": "npm run compile"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/vscode": "1.90.0",
    "typescript": "^5.4.5"
  }
}
